APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Enquiry notification — set ENQUIRY_TO_EMAIL to the inbox that should receive
# every contact-form submission. This is NOT editable in the admin panel.
# ---------------------------------------------------------------------------
ENQUIRY_TO_EMAIL=your-inbox@example.com

# ---------------------------------------------------------------------------
# SMTP credentials (replace the log driver above with smtp for production)
# Example using a transactional provider such as Mailgun, Postmark or Resend:
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=tls           # tls (port 587 STARTTLS) or ssl (port 465)
#   MAIL_HOST=smtp.mailgun.org
#   MAIL_PORT=587
#   MAIL_USERNAME=postmaster@mg.yourdomain.com
#   MAIL_PASSWORD=your-mailgun-smtp-password
#   MAIL_FROM_ADDRESS="noreply@konichiwachemicals.com"
#   MAIL_FROM_NAME="Konichiwa Chemicals"
#
# For Gmail SMTP (less preferred for production):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=tls
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=your-app-password   # Google app password, NOT your account password
# ---------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# BOOST_BROWSER_LOGS_WATCHER=false
# BOOST_ENABLED=false
# Added to prevent laravel boost into html response

KONICHIWA_PRODUCTS_API_KEY=
